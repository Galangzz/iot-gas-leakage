            {
                "name": "Small Desktop",
                "px": 768,
                "cols": 9
            },
            {
                "name": "Desktop",
                "px": 1024,
                "cols": 12
            }
        ],
        "tabs": [],
        "order": 0,
        "className": "",
        "visible": "true",
        "disabled": "false"
    },
    {
        "id": "gas-group-status",
        "type": "ui-group",
        "name": "Status",
        "page": "gas-page-monitor",
