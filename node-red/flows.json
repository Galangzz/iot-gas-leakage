    {
        "id": "gas-validasi",
        "type": "function",
        "name": "validasi data",
        "func": "const data = msg.payload\nconst statuses = ['WARMUP', 'SAFE', 'ALARM']\n\nif (!data || typeof data.avg !== 'number' || !statuses.includes(data.status)) {\n    return null\n}\n\nlet gauge = msg\nconst on = flow.get('stateOn')\nconst off = flow.get('stateOff')\n\nif (Number.isInteger(on) && Number.isInteger(off) && on > off) {\n    const key = on + ':' + off\n    if (flow.get('segmentsKey') !== key) {\n        flow.set('segmentsKey', key)\n        gauge = {\n            ...msg,\n            ui_update: {\n                segments: [\n                    { color: '#5CD65C', from: 0 },\n                    { color: '#FFC800', from: off },\n                    { color: '#EA5353', from: on }\n                ]\n            }\n        }\n    }\n}\n\nreturn [[gauge], [msg], [msg], [msg], [msg]]",
        "outputs": 5,
        "timeout": 0,
        "noerr": 0,
        "initialize": "flow.set('segmentsKey', null)",
        "finalize": "",
        "libs": [],
        "x": 540,
        "y": 120,
        "wires": [
            [
                "gas-gauge"
            ],
            [
                "gas-text-raw"
            ],
            [
                "gas-chart"
            ],
            [
                "gas-warnai"
            ],
            [
                "gas-pencatat"
            ]
        ],
        "z": "gas-tab-monitor"
    },
