[
    {
        "id": "gas-tab-monitor",
        "type": "tab",
        "label": "Gas Monitor",
        "disabled": false,
        "info": "Dashboard monitoring kebocoran gas MQ-5.\n\nTopik MQTT:\n- gas/rumah1/data\n- gas/rumah1/availability\n- gas/rumah1/threshold/state\n- gas/rumah1/threshold/set"
    },
    {
        "id": "gas-ui-base",
        "type": "ui-base",
        "name": "Gas Dashboard",
        "path": "/ui",
        "appIcon": "",
        "includeClientData": true,
        "acceptsClientConfig": [
            "ui-notification",
            "ui-control"
        ],
        "showPathInSidebar": false,
        "headerContent": "page",
        "navigationStyle": "default",
        "titleBarStyle": "default",
        "showReconnectNotification": true,
        "notificationDisplayTime": 1,
        "showDisconnectNotification": true,
        "allowInstall": false
    },
    {
        "id": "default",
        "type": "ui-theme",
        "name": "Default",
        "colors": {
            "surface": "#fcfcfd",
            "primary": "#0d74ce",
            "bgPage": "#f9f9fb",
            "groupBg": "#ffffff",
            "groupOutline": "#d9d9e0"
        },
        "sizes": {
            "density": "default",
            "pagePadding": "12px",
            "groupGap": "12px",
            "groupBorderRadius": "4px",
            "widgetGap": "12px"
        }
    },
    {
        "id": "gas-page-monitor",
        "type": "ui-page",
        "name": "Monitor Gas",
        "ui": "gas-ui-base",
