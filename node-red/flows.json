        "func": "if (flow.get('thresholdSeen')) {\n    return null\n}\n\nflow.set('inputOn', 3350)\nflow.set('inputOff', 3300)\nflow.set('stateOn', 3350)\nflow.set('stateOff', 3300)\n\nreturn [\n    { payload: 3350 },\n    { payload: 3300 },\n    { payload: 'Belum tersinkron dengan alat' }\n]",
        "outputs": 3,
        "timeout": 0,
