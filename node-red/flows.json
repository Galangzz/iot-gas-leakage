    {
        "id": "gas-validasi-threshold",
        "type": "function",
        "z": "gas-tab-monitor",
        "name": "validasi threshold",
        "func": "const on = flow.get('inputOn')\nconst off = flow.get('inputOff')\nconst valid = Number.isInteger(on) && Number.isInteger(off)\n    && off >= 0 && on <= 4095 && on > off\n\nif (!valid) {\n    node.status({ fill: 'red', shape: 'ring', text: 'tidak valid' })\n    msg.payload = 'Nilai tidak valid: pastikan 0 <= off < on <= 4095'\n    msg.topic = 'threshold/error'\n    return [null, msg]\n}\n\nnode.status({ fill: 'green', shape: 'dot', text: `${on}/${off}` })\nmsg.payload = JSON.stringify({ on, off })\nmsg.topic = 'gas/rumah1/threshold/set'\nreturn [msg, { payload: 'Menunggu konfirmasi alat...' }]",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 420,
        "y": 680,
        "wires": [
            [
                "gas-mqtt-out"
            ],
            [
                "gas-text-threshold"
            ]
