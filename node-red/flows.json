    {
        "id": "gas-sinkron",
        "type": "function",
        "z": "gas-tab-monitor",
        "name": "sinkron state",
        "func": "const doc = msg.payload\n\nif (!doc || typeof doc.on !== 'number' || typeof doc.off !== 'number') {\n    return null\n}\n\nflow.set('thresholdSeen', true)\nflow.set('inputOn', doc.on)\nflow.set('inputOff', doc.off)\nflow.set('stateOn', doc.on)\nflow.set('stateOff', doc.off)\n\nreturn [\n    { payload: doc.on },\n    { payload: doc.off },\n    { payload: `Threshold aktif: on=${doc.on}, off=${doc.off}` }\n]",
        "outputs": 3,
        "timeout": 0,
        "noerr": 0,
        "initialize": "flow.set('thresholdSeen', false)",
        "finalize": "",
        "libs": [],
        "x": 580,
        "y": 880,
        "wires": [
            [
                "gas-input-on"
            ],
            [
                "gas-input-off"
            ],
            [
                "gas-text-threshold"
            ]
        ]
    },
